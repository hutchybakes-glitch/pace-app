 ],
 "intent": [
  {"text": "I'm really struggling", "expect": "slower"},
  {"text": "this feels too easy, give me a faster target", "expect": "faster"},
  {"text": "how am I doing?", "expect": "status"},
  {"text": "can you slow it down a bit", "expect": "slower"},
  {"text": "I feel great, push me", "expect": "faster"},
  {"text": "my left calf is killing me", "expect": "pain"},
  {"text": "keep this pace, it's perfect", "expect": "hold"},
  {"text": "what's my pace", "expect": "status"},
  {"text": "I'm blowing up here", "expect": "slower"},
  {"text": "got a stitch", "expect": "pain"},
  {"text": "let's pick it up", "expect": "faster"},
  {"text": "how far is left", "expect": "status"},
  {"text": "I'm absolutely knackered", "expect": "slower"},
  {"text": "this is fine, stay like this", "expect": "hold"},
  {"text": "is that a dog over there", "expect": "none"},
  {"text": "it's not easy at all, I'm hanging on", "expect": "slower"}
 ],
 "plan": [
  {"name": "normal sub-threshold session", "feedback": {"session": "sub", "rpe": 6, "how": "plan", "legs": "ok", "energy": "ok", "pain": false}, "expect": "none"},
  {"name": "too hard, heavy legs, poor sleep", "feedback": {"session": "sub", "rpe": 9, "how": "hard", "legs": "heavy", "energy": "low", "pain": false, "note": "legs felt dead, slept badly all week"}, "expect": "ease_next_hard"},
  {"name": "knee pain", "feedback": {"session": "easy", "rpe": 5, "how": "plan", "legs": "sore", "energy": "ok", "pain": true, "where": "left knee", "note": "sharp pain on the downhills"}, "expect": "rest_soon"},
  {"name": "sub-threshold too easy again", "feedback": {"session": "sub", "rpe": 4, "how": "easy", "legs": "fresh", "energy": "great", "pain": false, "note": "felt easy again, second time this week"}, "expect": "harder"},
  {"name": "lovely long run", "feedback": {"session": "long", "rpe": 4, "how": "plan", "legs": "ok", "energy": "great", "pain": false, "note": "lovely run"}, "expect": "none"},
  {"name": "a cold", "feedback": {"session": "easy", "rpe": 6, "how": "plan", "legs": "ok", "energy": "low", "pain": false, "note": "I've got a cold, sore throat and a blocked nose"}, "expect": "rest_soon"},
  {"name": "busy week", "feedback": {"session": "long", "rpe": 5, "how": "plan", "legs": "ok", "energy": "ok", "pain": false, "note": "work is mad this week, I can only manage shorter runs"}, "expect": "cut_week"},
  {"name": "can't run Tuesday", "feedback": {"session": "long", "rpe": 4, "how": "plan", "legs": "ok", "energy": "ok", "pain": false, "note": "I can't run on Tuesday, I'm travelling for work"}, "expect": "touch_3_1"},
  {"name": "cut short, legs gone", "feedback": {"session": "sub", "rpe": 10, "how": "cut", "legs": "heavy", "energy": "low", "pain": false, "note": "had to stop after three reps, legs gone"}, "expect": "ease_next_hard"},
  {"name": "fresh easy run", "feedback": {"session": "easy", "rpe": 3, "how": "plan", "legs": "fresh", "energy": "great", "pain": false}, "expect": "none"},
  {"name": "tough but done", "feedback": {"session": "sub", "rpe": 7, "how": "plan", "legs": "ok", "energy": "ok", "pain": false, "note": "tough but I did it"}, "expect": "none"},
  {"name": "hills felt easy", "feedback": {"session": "hills", "rpe": 5, "how": "easy", "legs": "fresh", "energy": "great", "pain": false, "note": "hills felt easy today"}, "expect": "not_easier"},
  {"name": "bonked on the long run", "feedback": {"session": "long", "rpe": 8, "how": "hard", "legs": "heavy", "energy": "low", "pain": false, "note": "bonked at the end, really drained"}, "expect": "ease_next_hard"},
  {"name": "tired and stale", "feedback": {"session": "sub", "rpe": 8, "how": "plan", "legs": "heavy", "energy": "low", "pain": false, "note": "feeling tired and stale lately, motivation is low"}, "expect": "ease"}
 ]

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pacer.plan/1",
 "title": "Pacer training plan",
 "type": "object",
 "required": [
  "schema",
  "version",
  "plan",
  "weeks"
 ],
 "properties": {
  "schema": {
   "const": "pacer.plan"
  },
  "version": {
   "const": 1
  },
  "plan": {
   "type": "object",
   "required": [
    "name",
    "revision"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "revision": {
     "type": "integer",
     "minimum": 1
    },
    "race": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "distance_m": {
       "type": "number"
      },
      "date": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "fitness": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "vdot": {
       "type": "number"
      },
      "from": {
       "type": "string"
      }
     }
    },
    "units": {
     "const": "km"
    }
   }
  },
  "weeks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "week",
     "phase",
     "days"
    ],
    "properties": {
     "week": {
      "type": "integer",
      "minimum": 1
     },
     "start": {
      "type": [
       "string",
       "null"
      ]
     },
     "phase": {
      "enum": [
       "base",
       "build",
       "peak",
       "taper"
      ]
     },
     "test": {
      "type": "boolean"
     },
     "focus": {
      "type": "string"
     },
     "target_km": {
      "type": "number"
     },
     "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
       "type": "object",
       "required": [
        "day",
        "sessions"
       ],
       "properties": {
        "date": {
         "type": [
          "string",
          "null"
         ]
        },
        "day": {
         "enum": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
         ]
        },
        "sessions": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "id",
           "type",
           "zone",
           "hard"
          ],
          "additionalProperties": false,
          "properties": {
           "id": {
            "type": "string"
           },
           "type": {
            "enum": [
             "rest",
             "recovery",
             "easy",
             "strides",
             "hillsprints",
             "long",
             "sub",
             "hills",
             "sharpener",
             "rehearsal",
             "test",
             "race"
            ]
           },
           "title": {
            "type": "string"
           },
           "distance_m": {
            "type": [
             "number",
             "null"
            ],
            "minimum": 0
           },
           "duration_s": {
            "type": [
             "number",
             "null"
            ],
            "minimum": 0
           },
           "reps": {
            "type": [
             "object",
             "null"
            ],
            "required": [
             "count",
             "length_m",
             "rest_s"
            ],
            "properties": {
             "count": {
              "type": "integer",
              "minimum": 1
             },
             "length_m": {
              "type": "number",
              "minimum": 50
             },
             "rest_s": {
              "type": "number",
              "minimum": 0
             }
            }
           },
           "zone": {
            "enum": [
             "recovery",
             "easy",
             "steady",
             "subthreshold",
             "threshold",
             "interval",
             "repetition",
             "race",
             null
            ]
           },
           "pace_s_per_km": {
            "type": [
             "number",
             "null"
            ]
           },
           "km": {
            "type": "number",
            "minimum": 0
           },
           "hard": {
            "type": "boolean"
           },
           "notes": {
            "type": "string"
           },
           "changed": {
            "type": "boolean"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "changes": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "revision",
     "edits"
    ],
    "properties": {
     "revision": {
      "type": "integer"
     },
     "at": {
      "type": "string"
     },
     "source": {
      "enum": [
       "model",
       "rules",
       "you"
      ]
     },
     "say": {
      "type": "string"
     },
     "edits": {
      "type": "array"
     }
    }
   }
  }
 }
}
